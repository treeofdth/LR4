<Page x:Class="demo.Views.PageLog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:demo.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageLog">

    <Grid Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Grid.Column="0" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="Enter your name:" Margin="0,10,0,5"/>
                <TextBox x:Name="tbName" Padding="5"/>

                <Button Content="Add user" Padding="10" Margin="0,20,0,0"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="Enter your age:" Margin="0,10,0,5"/>
                <TextBox Padding="5"/>

                <Button Content="Add user" Padding="10" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>