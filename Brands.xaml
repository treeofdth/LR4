<Page x:Class="LR4__2.Views.Brands"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LR4__2.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Brands">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!--Pagination-->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10, 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBlock HorizontalAlignment="Center" Grid.Column="1" Text="Товары" VerticalAlignment="Top" FontSize="30" FontFamily="Segoe UI"/>
            <TextBlock Text="{Binding Items.Count, ElementName=lviewBrands, StringFormat='Кол-во товаров: {0}'}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" FontFamily="Segoe UI" Margin="10,0,0,0"/>
            <TextBox x:Name="tbSearch" Grid.Column="2" Height="32" VerticalContentAlignment="Center" ToolTip="Поиск товара" FontSize="14" FontFamily="Segoe UI" Margin="10,0,5,0" KeyDown="tbSearch_KeyDown"/>
            <Button Grid.Column="3" Content="Поиск" Width="80" Height="32" FontFamily="Segoe UI" Click="Button_Click_1"/>
            <Button Content="Сортировать по цене" Grid.Column="4" HorizontalAlignment="Right" Margin="5, 5, 10, 5" Click="Button_Click"/>
        </Grid>

        <ListView x:Name="lviewBrands" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" CornerRadius="4" BorderBrush="Black" Margin="5" Padding="6" Width="Auto" >

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding MainImagePath}" Height="170" Width="100" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,10,0"/>

                            <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center">
                                <!--Titles-->
                                <TextBlock FontFamily="Segoe UI" FontWeight="ExtraBold" FontSize="14">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="0">
                                            <Binding Path="Title"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="Gray">
                                    <Run Text="Производитель: "/>
                                    <Run Text="{Binding Manufacturer.Name}"/>
                                </TextBlock>

                                <!--Costs-->
                                <TextBlock FontWeight="DemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Цена: {0:.00}">
                                            <Binding Path="Cost"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <!--Pagination (numbers page)-->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,15">
            <Button Content="◀" Width="40" Height="32" Margin="0,0,6,0" Click="Button_Click_2" FontSize="14"/>

            <StackPanel x:Name="pageNumbersPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Button Content="▶" Width="40" Height="32" Margin="0,0,6,0" FontSize="14" Click="Button_Click_3"/>

            <TextBlock x:Name="tbPageInfo" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="14" FontFamily="Segoe UI"/>
        </StackPanel>
    </Grid>
</Page>
